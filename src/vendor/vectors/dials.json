{
  "description": "Creator-settable dial bounds on MsgUserRequestGuardians, pinned across implementations. The chain asserts these through ValidateBasic AND the keeper's context-dependent reveal-window check (x/secrets/keeper/dial_vectors_test.go); the TypeScript SDK asserts them through its DIALS descriptor table (dials.test.ts). A client that offers a value the chain rejects, or refuses one the chain accepts, fails its own suite. The commit window is NOT a dial: it is the protocol constant CommitTimeoutBlocks (50), which is why the reveal-offset floor is the constant 100 (commit window + 50-block buffer) rather than a computation. ValidateBasic checks every bound here including that floor; the keeper additionally requires the whole window to sit inside the horizon, which needs the block height and so stays keeper-only. Clients mirror the STRICTER (keeper) rule, because offering a value the handler will reject is the defect.",
  "bounds": {
    "threshold": { "min": 2, "max": 16 },
    "min_shares": { "min": 2, "max": 32 },
    "max_shares": { "absolute_max": 32, "gap_rule": "max_shares - min_shares < threshold" },
    "bump_hundredths": { "min": 100, "max": 1000 },
    "reveal_start_offset_blocks": {
      "min": 100,
      "rule": "min = CommitTimeoutBlocks (50) + 50 buffer; a constant, not derived from a creator input",
      "max": 5256000
    },
    "reveal_duration_blocks": { "min": 100, "max": 14400 },
    "reveal_horizon_blocks": {
      "max": 5256000,
      "rule": "start_offset + duration <= 5256000"
    }
  },
