{
  "name": "@timeflareio/typescript-sdk",
  "version": "0.0.8",
  "description": "JavaScript SDK for Timeflare client-side operations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "wasm/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/vendor/vectors && cp src/vendor/vectors/*.json dist/vendor/vectors/",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist wasm node_modules",
    "proto:gen": "echo 'Use: make proto-sync (fetches the pinned chain protos)' && exit 1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@cosmjs/crypto": "^0.39.0",
    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@noble/hashes": "^2.4.0",
    "@timeflareio/crypto": "https://github.com/timeflareio/crypto/releases/download/v0.0.2/timeflare-crypto-wasm-v0.0.2.tgz",
    "bech32": "^2.0.0"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.11",
    "ts-proto": "^2.12.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "timeflare",
    "crypto",
    "wasm",
    "shamir-secret-sharing",
    "threshold-cryptography",
    "hmac-verification",
    "encrypted-shares",
    "blockchain",
    "cosmos",
    "time-locked-secrets"
  ],
  "author": "Timeflare Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/timeflareio/typescript-sdk.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "bugs": {
    "url": "https://github.com/timeflareio/typescript-sdk/issues"
  },
  "homepage": "https://github.com/timeflareio/typescript-sdk#readme",
  "security": {
    "url": "https://github.com/timeflareio/typescript-sdk/security/policy"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/backends/wasm.d.ts",
      "default": "./dist/backends/wasm.js"
    },
    "./vectors/*.json": "./dist/vendor/vectors/*.json",
    "./package.json": "./package.json"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
