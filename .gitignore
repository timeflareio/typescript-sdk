# Dependencies and build output. These were ignored by the MONOREPO ROOT, not by
# this package — so a standalone clone had nothing ignoring them until now.
node_modules/
dist/
dist-release/

# WASM bundle: a released artefact from timeflareio/crypto, fetched by
# `make wasm-sync`. Never built here, never committed.
wasm/

# NB: src/vendor/vectors/ is deliberately NOT ignored, though the monorepo
# ignored it. There it was regenerated from ../testdata/vectors on every
# `pretest`, so it was ephemeral. Here the corpora come from two other
# repositories over the network, and committing them is what keeps the test
# suite hermetic — `make vectors-verify` is the separate, network-based check
# that the committed copies still match their owning repositories.

# macOS
.DS_Store

# Claude Code worktrees — machine-local execution checkouts, never history.
# Deliberately narrow: .claude/settings.json, agents and skills stay committable.
.claude/worktrees/
